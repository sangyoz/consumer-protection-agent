# start.bat 默认启动项目内 MySQL；首次启动会生成随机密码并更新下面一项。
# 如已有 MySQL，可填写自己的连接串（账号需具备 youli 库的建表/读写权限）。
DATABASE_URL=mysql+pymysql://youli:youli_dev_password@127.0.0.1:3306/youli?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可选：配置后通过 LangGraph 调用 DeepSeek OpenAI-compatible API。
# 空密钥时使用确定性演示规则，不会产生网络模型请求。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：使用已核对官方来源的 JSONL 法条语料导入本地 SQLite 法律库。
# 每行字段：id、law_name、article、content、source、effective_from、reviewed_at；可选 effective_to。
LAW_CORPUS_PATH=
# 可选：博查联网搜索，仅保留黑猫投诉和人民法院案例库域名的结果。
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
# 可选：法律库向量检索使用独立的 OpenAI-compatible Embeddings 服务。
# 没有此配置时仅使用 BM25；DeepSeek 聊天密钥不等于 Embeddings API 密钥。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
